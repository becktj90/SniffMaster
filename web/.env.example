# SniffMaster Web Dashboard — Environment Variables
# Copy this to .env.local for local dev, or set in Vercel dashboard for production.

# ⚠️  CRITICAL: Shared secret between ESP32 and the relay API.
# IMPORTANT: This key MUST also be set in firmware/include/web_dashboard_config.h
# Generate one: openssl rand -hex 16
# Then rebuild and flash the firmware with the new key.
SNIFFMASTER_API_KEY=change-me-to-a-random-secret

# Upstash Redis (free tier: https://upstash.com)
# Create a Redis database, then copy the REST credentials here.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your-token-here

# Optional: Enable weather briefing with AI-generated insights
# If not set, weather briefing uses deterministic local forecast
# OPENAI_API_KEY=sk-...

# Optional: Separate admin/owner key for dashboard management
# If not set, falls back to SNIFFMASTER_API_KEY for owner operations
# SNIFFMASTER_OWNER_KEY=...

# ── SMS alerts (Twilio) ───────────────────────────────────────────────
# Daily morning room-condition report + real-time threshold alerts (high
# humidity, high temp, sudden air-quality/gas drop). If any of these are
# unset, texting is silently skipped — the API and dashboard keep working.
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+13215551234
# Recipient phone number(s), E.164 format, comma-separated for multiple.
ALERT_SMS_TO=+13215559876

# Secret protecting the daily-summary cron endpoint from manual triggering.
# Vercel Cron is authorized automatically via its x-vercel-cron header; this
# secret lets you also trigger/test the report by hand:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://.../api/daily-summary
# Generate one: openssl rand -hex 16
CRON_SECRET=change-me-to-a-random-secret
