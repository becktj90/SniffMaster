# SniffMaster Environment Variables
# Copy this file to .env.local and fill in your values.

# ── Core API ──────────────────────────────────────────────────────────
# Device-to-API authentication key. Generate: openssl rand -hex 32
SNIFFMASTER_API_KEY=your-random-api-key-here

# ── Redis (Upstash) ───────────────────────────────────────────────────
# Serverless Redis for history, alerts, and caching.
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=AX...your-token-here

# ── SMS alerts (Amazon SNS, primary) ──────────────────────────────────
# Get AWS credentials from https://console.aws.amazon.com/iam/
# Create an IAM user whose only permission is sns:Publish (or AmazonSNSFullAccess).
#
# ⚠ The names are prefixed with SNS_ on purpose: Vercel runs on AWS Lambda and
# RESERVES the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION
# names — you cannot set those in the Vercel dashboard, and at runtime they
# contain Lambda's own credentials, which cannot send SMS.
SNS_AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
SNS_AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SNS_AWS_REGION=us-east-1
# Recipient phone number(s), E.164 format, comma-separated for multiple.
# Optional — defaults to the owner's number in lib/notify.js when unset.
ALERT_SMS_TO=+15104324862

# ── SMS/MMS alerts (ClickSend, fallback) ──────────────────────────────
# Used when SNS is unconfigured or every SNS send fails. No per-sender brand
# registration required (unlike Twilio's US A2P 10DLC, which is why Twilio
# support was dropped). Get credentials from https://dashboard.clicksend.com
# CLICKSEND_USERNAME=you@example.com
# CLICKSEND_API_KEY=your-clicksend-api-key
# Sender number shown to recipients. Defaults to +18335304015 if unset.
# CLICKSEND_FROM=+18335304015
# When the daily report's opts include an image (the report-card PNG), the
# send goes out as MMS instead of plain SMS — same credentials, no extra config.

# ── Push alerts (ntfy, free guaranteed channel) ───────────────────────
# When set, EVERY alert/report is also published as a push notification, in
# parallel with the SMS attempt. This is deliberate: SMS providers can accept
# a message (API "success") that carriers then silently drop (SNS sandbox,
# unregistered A2P/toll-free numbers), so SMS success is not proof of
# delivery. Expect duplicates once real SMS starts landing — remove this var
# (and redeploy) if you'd rather trust SMS alone.
# No account or carrier registration needed:
#   1. Pick a long random topic name (it acts as the password):
#      openssl rand -hex 12
#   2. Set it here, redeploy.
#   3. Install the ntfy app (iOS/Android) and subscribe to the same topic.
# NTFY_TOPIC=sniffmaster-alerts-<random-suffix>
# Or a full URL for a self-hosted ntfy server (takes precedence over NTFY_TOPIC):
# NTFY_URL=https://ntfy.example.com/my-topic

# Secret protecting the daily-summary generate+send path. STRONGLY RECOMMENDED.
# When set, Vercel Cron automatically includes "Authorization: Bearer $CRON_SECRET"
# on scheduled invocations, and the same header lets you trigger/test by hand:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://.../api/daily-summary
# Without it, the endpoint falls back to trusting Vercel's cron user-agent,
# which is spoofable (rate-limited to one send per 6h by the built-in lock).
# Generate one: openssl rand -hex 16
CRON_SECRET=change-me-to-a-random-secret

# ── OpenAI (optional) ─────────────────────────────────────────────────
# Powers the weather briefing AND the personal-voice daily SMS report.
# If unset, both fall back to deterministic local text (no cost).
# OPENAI_API_KEY=sk-...
# OPENAI_REPORT_MODEL=gpt-5.4-nano

# ── Public site URL (optional) ─────────────────────────────────────────
# Base URL the report-card image and dashboard link in outgoing
# messages/MMS resolve against. Defaults to the production Vercel domain.
# PUBLIC_BASE_URL=https://sniffmaster-web.vercel.app
