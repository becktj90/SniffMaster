# Copy this file to .env and fill in the SMS provider credentials below
# before running ntfy_sms_forwarder.py. See README.md for full setup
# instructions.

# ── ntfy ──────────────────────────────────────────────────────────────
# Base URL of the ntfy server (use https://ntfy.sh unless self-hosting).
NTFY_BASE_URL=https://ntfy.sh
# The ntfy topic to listen on (must match what publishes notifications).
NTFY_TOPIC=your-ntfy-topic-here

# ── SMS provider ─────────────────────────────────────────────────────
# ClickSend is the sole SMS provider (Twilio support has been removed
# entirely). ClickSend doesn't require Twilio's A2P 10DLC brand
# registration step, which can be stuck behind an unusable "Mock Brand"
# on a Twilio Trial account and take hours-to-days to approve even on a
# paid one.

# ── ClickSend (https://dashboard.clicksend.com) ─────────────────────────
# Find these under Dashboard > API Credentials.
CLICKSEND_USERNAME=your-clicksend-username
CLICKSEND_API_KEY=your-clicksend-api-key
# Optional custom sender ID/number. Leave blank to use ClickSend's default
# shared number (recommended for the US, where custom alphanumeric senders
# aren't supported on two-way numbers).
CLICKSEND_FROM=

# Destination phone number in E.164 format. Replaces the old AT&T
# email-to-SMS gateway address (txt.att.net silently dropped messages).
ALERT_SMS_TO=+15104324862
