# Copy this file to .env and fill in the SMS provider credentials below
# before running ntfy_sms_forwarder.py. See README.md for full setup
# instructions.

# ── ntfy ──────────────────────────────────────────────────────────────
# Base URL of the ntfy server (use https://ntfy.sh unless self-hosting).
NTFY_BASE_URL=https://ntfy.sh
# The ntfy topic to listen on (must match what publishes notifications).
NTFY_TOPIC=your-ntfy-topic-here

# ── SMS provider selection ─────────────────────────────────────────────
# "clicksend" (default) or "twilio". ClickSend is the default because it
# doesn't require Twilio's A2P 10DLC brand registration step, which can be
# stuck behind an unusable "Mock Brand" on a Twilio Trial account and take
# hours-to-days to approve even on a paid one.
SMS_PROVIDER=clicksend

# ── ClickSend (default — https://dashboard.clicksend.com) ──────────────
# Find these under Dashboard > API Credentials.
CLICKSEND_USERNAME=your-clicksend-username
CLICKSEND_API_KEY=your-clicksend-api-key
# Optional custom sender ID/number. Leave blank to use ClickSend's default
# shared number (recommended for the US, where custom alphanumeric senders
# aren't supported on two-way numbers).
CLICKSEND_FROM=

# ── Twilio (only used when SMS_PROVIDER=twilio) ─────────────────────────
# Find these in the Twilio Console (https://console.twilio.com).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
# Normally just set TWILIO_AUTH_TOKEN. If your platform's secret storage ever
# silently truncates that specific key (seen once on this project — the
# stored value kept getting cut short no matter how it was re-entered), set
# the same value under TWILIO_AUTH_TOKEN_V2 instead; the script prefers it
# when present. See ntfy_sms_forwarder.py for details.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_AUTH_TOKEN_V2=
# Either a Messaging Service SID (preferred, picks a sender from a
# registered pool) or a bare From number in E.164 format. Messaging
# Service takes priority if both are set.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=+15555550100

# Destination phone number in E.164 format. Replaces the old AT&T
# email-to-SMS gateway address (txt.att.net silently dropped messages).
ALERT_SMS_TO=+15104324862
