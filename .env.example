# Copy this file to .env and fill in the Brevo credentials below before
# running ntfy_sms_forwarder.py. See README.md for full setup instructions.

# ── ntfy ──────────────────────────────────────────────────────────────
# Base URL of the ntfy server (use https://ntfy.sh unless self-hosting).
NTFY_BASE_URL=https://ntfy.sh
# The ntfy topic to listen on. THIS MUST EXACTLY MATCH the web app's
# NTFY_TOPIC (its Vercel env var) — that's the whole integration: the
# dashboard publishes alerts/reports to this topic, and this forwarder turns
# each one into an SMS. A mismatch means the forwarder sits silent with no
# error. (.replit ships sniffmaster-pro-alerts-7f3k2 as the shared default.)
NTFY_TOPIC=your-ntfy-topic-here

# ── Brevo (SMS sent over the real SMS network, not an email gateway) ──
# Get an API key from https://app.brevo.com -> Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=xkeysib-your-api-key-here
# Sender name/number shown to the recipient. Max 15 chars: up to 11 if
# alphanumeric, up to 15 if numeric (a real phone number). Some countries
# require this sender to be pre-approved in the Brevo dashboard
# (Transactional -> SMS -> Senders) before sends will succeed — check there
# first if every send fails with the same error.
BREVO_SMS_SENDER=SniffMaster

# Destination phone number in E.164 format. Replaces the old AT&T
# email-to-SMS gateway address (txt.att.net silently dropped messages).
ALERT_SMS_TO=+15104324862
