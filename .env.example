# Copy this file to .env and fill in the SMTP credentials below before
# running ntfy_sms_forwarder.py. See README.md for full setup instructions.

# ── ntfy ──────────────────────────────────────────────────────────────
# Base URL of the ntfy server (use https://ntfy.sh unless self-hosting).
NTFY_BASE_URL=https://ntfy.sh
# The ntfy topic to listen on (must match what publishes notifications).
NTFY_TOPIC=your-ntfy-topic-here

# ── Email-to-SMS gateway (sent via SMTP) ────────────────────────────────
# SMTP server used to relay the email that the carrier gateway turns into
# an SMS (e.g. Gmail's smtp.gmail.com with an App Password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SENDER_EMAIL=your-email@gmail.com

# Carrier Email-to-SMS gateway address for the destination phone number.
# Hardcoded per project owner request (AT&T gateway for 510-432-4862).
SMS_GATEWAY_ADDRESS=15104324862@txt.att.net
